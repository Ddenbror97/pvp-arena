# Copy to .env (gitignored). Never commit real values.

# --- App / Supabase (production or staging) ---
# Auth: enable "Prevent use of leaked passwords" in Dashboard (Email provider); not env-configurable.
SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres URL for migrations/audit scripts only — not for Vitest.
SUPABASE_DB_URL=

VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Database integration tests (isolated Postgres only) ---
# Required for: npm run test:db:rollout
# Must NOT be the production host, pooler user, or project ref (see tests/db/test-url.ts).
# CI: set repository secret TEST_DATABASE_URL, or rely on the workflow Postgres service.
# Local: e.g. Docker postgres:17 on 5433, then:
# TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/postgres
TEST_DATABASE_URL=

# Used with TEST_DATABASE_URL so tests refuse to hit production if misconfigured:
# SUPABASE_DB_URL and SUPABASE_PROJECT_ID should match your live project metadata.

# --- GitHub CLI / scripts/ci/rollout-ci.mjs (never commit) ---
# Fine-grained or classic PAT: repo + Actions read/write to dispatch and watch CI.
# GH_TOKEN=

# --- Optional (see btcpay.secrets.example, RPC scripts, etc.) ---
# OTP_PEPPER=
# Game-page signup invite. The modal stays off unless this is exactly "true".
# Production deploy sets the worker var to true in scripts/cf-patch-wrangler.mjs.
# GAME_SIGNUP_PROMO_ENABLED=false
# RESEND_API_KEY=
# Base (8453) USDC and ETH deposits and withdrawals. Two independent RPC providers read
# the chain and must agree before anything is credited or paid. Deposits are found through
# Alchemy's transfer index (alchemy_getAssetTransfers): set CRYPTO_ALCHEMY_URL_8453, or make
# one of the two RPC URLs the Alchemy one. Without an index the watcher can only scan a few
# blocks a run. Set the index's secret BEFORE deploying a build that needs it.
# The ETH/USD price for ETH deposits is read on-chain from the Chainlink feed in
# chain_assets.price_feed_address (no key).
# CRYPTO_RPC_URL_8453=https://<provider-a>/<key>
# CRYPTO_RPC_URL_8453_B=https://<provider-b>/<key>
# CRYPTO_ALCHEMY_URL_8453=https://base-mainnet.g.alchemy.com/v2/<key>

# FPS Duel casino server bindings. Share the secret only with the separate
# match Worker; do not prefix it with VITE_. See docs/FPS-OPERATIONS.md.
# FPS_RUNTIME_ORIGIN=https://your-staging-fps-worker.workers.dev
# FPS_RUNTIME_SECRET=
