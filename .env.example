# Copy to .env (gitignored). Never commit real values.

# --- App / Supabase (production or staging) ---
# Auth: enable "Prevent use of leaked passwords" in Dashboard (Email provider); not env-configurable.
SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres URL for migrations/audit scripts only — not for Vitest.
SUPABASE_DB_URL=

VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Database integration tests (isolated Postgres only) ---
# Required for: npm run test:db:rollout
# Must NOT be the production host, pooler user, or project ref (see tests/db/test-url.ts).
# CI: set repository secret TEST_DATABASE_URL, or rely on the workflow Postgres service.
# Local: e.g. Docker postgres:17 on 5433, then:
# TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/postgres
TEST_DATABASE_URL=

# Used with TEST_DATABASE_URL so tests refuse to hit production if misconfigured:
# SUPABASE_DB_URL and SUPABASE_PROJECT_ID should match your live project metadata.

# --- GitHub CLI / scripts/ci/rollout-ci.mjs (never commit) ---
# Fine-grained or classic PAT: repo + Actions read/write to dispatch and watch CI.
# GH_TOKEN=

# --- Optional (see btcpay.secrets.example, RPC scripts, etc.) ---
# OTP_PEPPER=
# RESEND_API_KEY=
# Base ETH deposits use Ankr's address index. Chainstack is the second provider
# that confirms the receipt. Either URL may be the Ankr one.
# CRYPTO_RPC_URL_8453=https://rpc.ankr.com/base/<key>
# CRYPTO_RPC_URL_8453_B=https://base-mainnet.core.chainstack.com/<key>
# Internal ETH traces only. NodeFlare free Base key. Not the public endpoint.
# trace_filter and debug_traceTransaction cost 100 CU each. The free tier is
# 3,000,000 CU/month and 10 requests/second. A monthly quota response leaves the
# deposit uncredited and retries later. This client does not upgrade the plan.
# CRYPTO_TRACE_URL_8453=https://rpc.nodeflare.app/base/v1/<key>
#
# Base deposit sweep (ETH and USDC only). Leave both unset until the recovery
# plan is approved. The worker sweeps nothing unless the flag is exactly "true".
# CRYPTO_DEPOSIT_XPRV is the account extended private key that matches
# CRYPTO_DEPOSIT_XPUB (same public key and chain code). Set it only as a
# Cloudflare Worker secret, in the dashboard, on the pvpspinarena worker.
# Do not commit it, do not paste it into chat, and do not put it in this file.
# The worker reads it inside the deposit job, derives m/0/8453/<index>, and
# signs a sweep only when that child key can actually spend the published
# deposit address. If the published address and the spendable address differ,
# the job stops before any signature.
# It is not returned to the browser and is redacted from logs.
# CRYPTO_DEPOSIT_SWEEP_ENABLED=true
# CRYPTO_DEPOSIT_XPRV=
