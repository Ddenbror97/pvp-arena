// Dead-code audit config: `npx knip@5` (not installed as a dependency).
{
  "$schema": "https://unpkg.com/knip@5/schema-jsonc.json",
  "entry": [
    "src/routes/**/*.tsx",
    "src/router.tsx",
    "src/server.ts",
    "src/**/*.functions.ts",
    "src/**/*.server.ts",
    "workers/**/index.ts",
    "scripts/**/*.{ts,mjs}",
    "tests/**/*.{ts,tsx}",
    "playwright*.config.ts",
    "pw-*.config.ts",
    "plugins/**/*.{ts,js}",
  ],
  // An export also used in its own file is not dead code.
  "ignoreExportsUsedInFile": true,
  "project": ["src/**/*.{ts,tsx}", "workers/**/*.ts", "scripts/**/*.{ts,mjs}"],
  "ignore": [
    // Generated by Supabase; its helper types are public API by design.
    "src/integrations/supabase/types.ts",
  ],
  "ignoreDependencies": [
    // Loaded through CSS (@import) / the Vite config, not from TS.
    "tw-animate-css",
    "tailwindcss",
    "@tailwindcss/vite",
    // Optional peer of @lovable.dev/vite-tanstack-config, which resolves it at build
    // time to write the route manifest. Never imported by the app; keep it.
    "@tanstack/router-generator",
  ],
}
