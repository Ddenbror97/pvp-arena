// Dead-code audit config: `npx knip@5` (not installed as a dependency).
{
  "$schema": "https://unpkg.com/knip@5/schema-jsonc.json",
  "entry": [
    "src/routes/**/*.tsx",
    "src/**/*.functions.ts",
    "src/**/*.server.ts",
    "workers/**/index.ts",
    // The dedicated Battle Royale Worker (wrangler.br.jsonc "main").
    "workers/fps/br-worker.ts",
    "scripts/**/*.{ts,mjs}",
    "tests/**/*.{ts,tsx}",
    "playwright*.config.ts",
    "plugins/**/*.{ts,js}",
  ],
  // An export also used in its own file is not dead code.
  "ignoreExportsUsedInFile": true,
  "project": ["src/**/*.{ts,tsx}", "workers/**/*.ts", "scripts/**/*.{ts,mjs}"],
}
