{
  "name": "tanstack_start_ts",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "preview": "wrangler dev --config .output/server/wrangler.json",
    "deploy": "vite build && node --env-file=.env scripts/cf-patch-wrangler.mjs && wrangler deploy --config .output/server/wrangler.json",
    "cf:login": "wrangler login",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:db:rollout": "vitest run --maxWorkers=1 --hookTimeout 300000 --sequence.concurrent=false --testTimeout 300000 tests/db/withdraw-basis-parity.integration.test.ts tests/db/bonus-withdraw.integration.test.ts tests/db/leaderboard.integration.test.ts tests/db/partner-leaderboard-cohort.integration.test.ts tests/db/withdraw-basis-sync-bench.integration.test.ts",
    "ci:rollout": "node --env-file=.env scripts/ci/rollout-ci.mjs"
  },
  "overrides": {
    "rolldown": "1.2.1"
  },
  "dependencies": {
